    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
