{
  "name": "the-bigshot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THE BIGSHOT - a 3D open-world life, employment and economic simulation",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
